# LabelVerify AI — backend environment template (safe to commit).
# Copy to backend/.env for local uvicorn development:
#   cp backend/.env.example backend/.env
#
# OpenAI is OPTIONAL. Core label verification works without it.
# Set OPENAI_ENABLED=true and provide OPENAI_API_KEY only when testing
# optional AI evidence recovery.
#
# Never commit a real API key.
# OPENAI_API_KEY is backend-only — never put it in VITE_* or frontend env files.
# See docs/AI_FALLBACK.md

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=LabelVerify AI
APP_ENV=development
APP_VERSION=0.8.0
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated CORS origins (local Vite default)
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./data/labelverify.db
UPLOAD_DIR=./data/uploads

# -----------------------------------------------------------------------------
# OpenAI — OPTIONAL; disabled by default in this template
# -----------------------------------------------------------------------------
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=8
OPENAI_MAX_CALLS_PER_REVIEW=1
OPENAI_MAX_IMAGE_EDGE_PX=1280

# -----------------------------------------------------------------------------
# Batch processing
# -----------------------------------------------------------------------------
BATCH_MAX_ITEMS=300
BATCH_MAX_CONCURRENCY=2
BATCH_AI_MAX_CALLS=25
BATCH_AI_CONCURRENCY=1

# -----------------------------------------------------------------------------
# OCR (Tesseract primary)
# -----------------------------------------------------------------------------
OCR_PROVIDER=tesseract
OCR_PREPROCESS_PROFILE=fast
OCR_FAST_MAX_EDGE_PX=1600
OCR_ENHANCED_MAX_EDGE_PX=1200

# Phase 8.9 selective brand escalation (Tesseract region retry; optional RapidOCR)
BRAND_REGION_OCR_ENABLED=true
SECONDARY_OCR_ENABLED=false
SECONDARY_OCR_PROVIDER=rapidocr

# -----------------------------------------------------------------------------
# Image upload limits (engineering heuristics)
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_DIMENSION_PX=8000
MIN_IMAGE_DIMENSION_PX=100
DISPLAY_MAX_EDGE_PX=2400
OCR_PREVIEW_MAX_EDGE_PX=2200

# -----------------------------------------------------------------------------
# Comparison heuristics (engineering — not regulatory certainty)
# -----------------------------------------------------------------------------
BRAND_PASS_RATIO=95
BRAND_REVIEW_RATIO=85
CLASS_PASS_RATIO=97
ABV_COMPARE_EPSILON=0.05
NET_CONTENTS_EPSILON_ML=0.5
