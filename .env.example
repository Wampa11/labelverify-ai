# LabelVerify AI — Docker Compose / shared deployment template (safe to commit).
# For local uvicorn backend development, prefer:
#   cp backend/.env.example backend/.env
#
# For Docker Compose, you may copy this file to the repo-root `.env`
# (used for Compose interpolation) AND/OR populate backend/.env
# (injected into the backend container via env_file).
#
# Never commit a real `.env` or API key.
# Do NOT put secrets in frontend Vite environment variables (VITE_*).

# -----------------------------------------------------------------------------
# Application / Compose
# -----------------------------------------------------------------------------
APP_NAME=LabelVerify AI
APP_ENV=production
APP_VERSION=0.8.0
LOG_LEVEL=INFO

# Host port published for the frontend container (Compose)
FRONTEND_HOST_PORT=8080

# Bind address for the published frontend port (Compose).
# Default 127.0.0.1: local UI + same-host cloudflared only (not LAN-wide).
# Set 0.0.0.0 only for rare LAN demos — not required for Cloudflare Tunnel.
FRONTEND_BIND_HOST=127.0.0.1

# CORS — Compose default targets the published UI origin (local).
# Same-origin /api via the public hostname does not require listing that hostname here.
# Add extra origins only if something calls the API cross-origin.
CORS_ORIGINS=http://localhost:8080

# -----------------------------------------------------------------------------
# OpenAI — backend only; OPTIONAL; disabled by default
# Never put the API key in VITE_* frontend env.
# -----------------------------------------------------------------------------
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=8
OPENAI_MAX_CALLS_PER_REVIEW=1
OPENAI_MAX_IMAGE_EDGE_PX=1280

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# Backend Settings load backend/.env for local development.
# Docker Compose injects backend/.env into the backend service (required: false).
# OpenAI never affects /ready — the API starts without a key.
#
# Optional Phase 8.9 secondary OCR (RapidOCR) is configured in backend/.env:
#   BRAND_REGION_OCR_ENABLED, SECONDARY_OCR_ENABLED, SECONDARY_OCR_PROVIDER
# See docs/OCR_ESCALATION.md — not a readiness requirement.
